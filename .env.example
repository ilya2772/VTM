# PostgreSQL connection string. Use a dedicated local database and never commit credentials.
DATABASE_URL="postgresql://vtm_user:change-me@localhost:5432/vtm?schema=public"

# Server-only Pyth Pro credential. Leave empty in demo mode.
PYTH_PRO_API_KEY=""
PYTH_CHANNEL="fixed_rate@200ms"
PYTH_STALE_AFTER_MS="5000"

# Market data: pyth | demo
MARKET_DATA_MODE="pyth"

# Chart implementation: tradingview | lightweight
CHART_ENGINE="lightweight"

# Session lifetime in seconds. Defaults to seven days when omitted.
SESSION_TTL_SECONDS="604800"

# Public application origin used for Checkout redirects.
APP_URL="http://localhost:3000"

# Challenge checkout: mock | stripe. Stripe mode accepts test keys only.
PAYMENT_MODE="mock"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
